# Database Configuration
# PostgreSQL connection settings

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=equiem_db
DB_SSL=false


# AWS Configuration
# AWS credentials used for S3 and SQS access.
# When using AWS Academy Lab, credentials are temporary.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SESSION_TOKEN=your_session_token

# AWS Services
# Storage bucket for uploads
AWS_S3_BUCKET=your-bucket-name

# Queue used for background processing
AWS_SQS_QUEUE_URL=https://sqs.region.amazonaws.com/account-id/queue-name

# Onboarding Admin Notification (SMTP)
# Sent when a user finishes and submits the onboarding form.
ONBOARDING_SMTP_HOST=localhost
ONBOARDING_SMTP_PORT=1025
ONBOARDING_SMTP_USER=
ONBOARDING_SMTP_PASS=
ONBOARDING_EMAIL_FROM=
# Comma-separated list of admin recipients
ONBOARDING_ADMIN_EMAIL_TO=admin1@updata.local,admin2@updata.local

# Public frontend base URL used to generate onboarding links
FRONTEND_BASE_URL=http://localhost:4200

# Onboarding Admin Notification (SMTP)
# Sent when a user finishes and submits the onboarding form.
ONBOARDING_SMTP_HOST=localhost
ONBOARDING_SMTP_PORT=1025
ONBOARDING_SMTP_USER=
ONBOARDING_SMTP_PASS=
ONBOARDING_EMAIL_FROM=
# Comma-separated list of admin recipients
ONBOARDING_ADMIN_EMAIL_TO=admin1@updata.local,admin2@updata.local