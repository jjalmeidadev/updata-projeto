# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first for better cache reuse across source changes.
COPY package*.json ./
RUN npm ci && npm cache clean --force \
    && npm install --no-save esbuild

COPY tsconfig.json ./
COPY src ./src

# Bundle backend into a single optimized entrypoint.
RUN npx esbuild src/server.ts \
    --bundle \
    --platform=node \
    --target=node20 \
    --format=cjs \
    --minify \
    --outfile=dist/server.cjs \
    && npx esbuild src/business/workers/upload-worker.ts \
    --bundle \
    --platform=node \
    --target=node20 \
    --format=cjs \
    --minify \
    --outfile=dist/worker.cjs

# Stage 2: Runtime
FROM node:20-alpine AS runner

# Create non-root user for safer production runtime.
RUN addgroup -g 1001 -S nodejs \
    && adduser -S nodejs -u 1001 -G nodejs

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=96

# Runtime image only receives compiled artifacts.
COPY --from=builder /app/dist ./dist

RUN chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 3000

CMD ["node", "dist/server.cjs"]
