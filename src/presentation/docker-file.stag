FROM node:20-alpine AS build

WORKDIR /workspace

ENV NODE_ENV=staging
ENV NG_CLI_ANALYTICS=false
ENV NODE_OPTIONS=--max-old-space-size=192

COPY src/presentation/web/package*.json ./
RUN npm ci --no-audit --no-fund

COPY src/presentation/web .
RUN npm run build -- --configuration production


# Runtime image serves static Angular build with nginx.
FROM nginx:1.27-alpine AS runtime

RUN printf "server {\n  listen 80;\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n\n  location /healthz {\n    access_log off;\n    add_header Content-Type text/plain;\n    return 200 'ok';\n  }\n}\n" > /etc/nginx/conf.d/default.conf

COPY --from=build /workspace/dist/app/browser /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
