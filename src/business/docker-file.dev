FROM node:20-alpine

WORKDIR /app

# Install dependencies once and leverage Docker layer cache.
COPY package*.json ./
RUN npm ci 

# Copy backend source tree.
COPY src ./src

ENV NODE_ENV=development
ENV DEBUG=true
ENV NODE_OPTIONS=--max-old-space-size=96

USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD node -e "const req=require('http').request({host:'127.0.0.1',port:3000,path:'/'},()=>process.exit(0));req.on('error',()=>process.exit(1));req.end();"

CMD ["npm", "run", "dev"]